            $(document).ready(function () {
            var table = $('#incentiveTable').DataTable({
                ajax: {
                    url: '/Incentive/GetIncentives',
                    dataSrc: 'data'
                },
                columns: [
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
        <input type="checkbox" class="row-select" data-id="${row.id}" />`;
                        },
                        orderable: false
                    },
                    { data: 'id' },
                    { data: 'name' },
                    { data: 'amount' }
                ],
                dom: 'Bfrtip',
                buttons: ['excelHtml5', 'pdfHtml5', 'print'],
                responsive: true
            });

            $('#saveSelectedBtn').on('click', function () {
                var selectedRows = [];

                $('#incentiveTable tbody input.row-select:checked').each(function () {
                    var rowData = table.row($(this).closest('tr')).data();
                    selectedRows.push(rowData);
                });

                if (selectedRows.length === 0) {
                    alert("Please select at least one row.");
                    return;
                }

                $.ajax({
                    url: '/Incentive/SaveSelected',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(selectedRows),
                    success: function (response) {
                        alert(response.message);
                    },
                    error: function () {
                        alert('Failed to save selected rows.');
                    }
                });
            });
        });



    </script>








}













