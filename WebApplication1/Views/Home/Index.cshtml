<h2>Add Incentive</h2>

<form asp-action="Add" asp-controller="Home" method="post">
    <input name="id" type="number" placeholder="Employee ID" required />
    <input name="name" type="text" placeholder="Branch Code" required />
    <input name="amount" type="number" step="0.01" placeholder="Team Kpi" required />
    <button type="submit">Submit</button>
</form>

<hr />






<h2>Incentive List</h2>

<table id="incentiveTable" class="display nowrap" style="width:100%">
    <thead>
     @*    <tr>
            <th>Employee ID</th>
            <th>Branch Code</th>
            <th>Team Kpi</th>
        </tr> *@


        <tr>
            <th>Select</th>
            <th>ID</th>
            <th>Name</th>
            <th>Amount</th>
        </tr>
    </thead>
</table>


<button id="saveSelectedBtn" class="btn btn-primary">Save Selected</button>



@{
    ViewData["Title"] = "Account Transactions";
}

<div class="container mt-4">
    <h2 class="mb-4">Bank Account Transactions</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <form asp-action="Credit" method="post" class="mb-4">
        <div class="card p-3 mb-3">
            <h4>Credit Account</h4>
            <div class="mb-3">
                <label>Account Number</label>
                <input type="text" name="accountNo" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Amount</label>
                <input type="number" name="amount" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success">Credit</button>
        </div>
    </form>

    <form asp-action="Debit" method="post">
        <div class="card p-3">
            <h4>Debit Account</h4>
            <div class="mb-3">
                <label>Account Number</label>
                <input type="text" name="accountNo" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Amount</label>
                <input type="number" name="amount" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-danger">Debit</button>
        </div>
    </form>
</div>

@if (ViewBag.AccountNo != null)
{
    <div class="card my-4 p-3 shadow-sm">
        <h5>Account Summary</h5>
        <p><strong>Account:</strong> @ViewBag.AccountNo</p>
        <p><strong>Current Balance:</strong> @ViewBag.Balance.ToString("C")</p>
    </div>

    <div class="card my-4 p-3 shadow-sm">
        <h5>Recent Transactions</h5>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Date & Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in (List<WebApplication1.Models.TransactionLog>)ViewBag.History)
                {
                    <tr>
                        <td>@txn.Type</td>
                        <td>@txn.Amount.ToString("C")</td>
                        <td>@txn.Time</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


